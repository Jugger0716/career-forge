{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devcareer-prep.local/schemas/gap-report.schema.json",
  "title": "DevCareer Prep Gap Report",
  "description": "L3 갭 리포트(gap-report.json). knowledge-map.json 노드 ID만 참조한다(단방향 6계층 참조). MVP는 자가진단 입력만 받고 퀴즈로 검증하지 않는다(오류 증폭 사슬 방지) — GapAnalyzer가 사용자 자가진단과 지식맵을 대조해 생성한다.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "generatedAt", "sourceRepoHead", "contentHash",
    "coverage", "truncated", "nodes"
  ],
  "properties": {
    "schemaVersion": { "$ref": "#/$defs/schemaVersion" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "sourceRepoHead": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$",
      "description": "생성 시점 대상 레포 HEAD. AC-22 스테일 판정의 정본 값."
    },
    "contentHash": {
      "type": "string",
      "minLength": 1,
      "description": "이 파일 본문(generatedAt과 이 필드 자신은 제외)의 SHA-256 해시. 우발적 손상·부분 편집을 잡기 위한 필드이며, 키 없는 SHA-256이므로 의도적 위조는 막지 못한다(evidence.json에서만 scripts/verify-evidence.mjs·validate-plugin.mjs --schema-check가 scripts/lib/content-hash.mjs로 재계산·대조한다 — 이 L1+ 레이어는 그 결정적 생성기가 이 레포에 아직 구현되어 있지 않다)."
    },
    "coverage": { "$ref": "#/$defs/coverage" },
    "truncated": { "$ref": "#/$defs/truncated" },
    "nodes": {
      "type": "array",
      "items": { "$ref": "#/$defs/gapNode" }
    }
  },
  "$defs": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "default": "0.1.0"
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["analyzed", "total", "traversed", "period", "exclusions", "samplingMethod"],
      "properties": {
        "analyzed": { "type": "integer", "minimum": 0 },
        "total": { "type": "integer", "minimum": 0 },
        "traversed": { "type": "integer", "minimum": 0 },
        "period": {
          "type": "object",
          "additionalProperties": false,
          "required": ["since", "until"],
          "properties": {
            "since": { "type": ["string", "null"], "format": "date" },
            "until": { "type": ["string", "null"], "format": "date" }
          }
        },
        "exclusions": {
          "type": "object",
          "additionalProperties": false,
          "required": ["bots", "vendoredPaths", "mergeIncluded", "selectedIdentities"],
          "properties": {
            "bots": { "type": "boolean" },
            "vendoredPaths": { "type": "boolean" },
            "mergeIncluded": { "type": "boolean" },
            "selectedIdentities": { "type": "array", "items": { "type": "string", "format": "email" } }
          }
        },
        "samplingMethod": { "type": "string", "x-verbatim": true, "minLength": 1 }
      }
    },
    "truncated": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason", "dropped_commits"],
      "properties": {
        "reason": { "type": "string", "enum": ["none", "budget_commits"] },
        "dropped_commits": { "type": "integer", "minimum": 0 }
      },
      "allOf": [
        { "if": { "properties": { "reason": { "const": "none" } } }, "then": { "properties": { "dropped_commits": { "const": 0 } } } },
        { "if": { "properties": { "reason": { "const": "budget_commits" } } }, "then": { "properties": { "dropped_commits": { "minimum": 1 } } } }
      ]
    },
    "evidenceCitation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ledgerId"],
      "properties": {
        "ledgerId": { "type": "string", "minLength": 1 },
        "path": { "type": "string" }
      }
    },
    "basis": {
      "type": "string",
      "enum": ["inference", "external", "insufficient"],
      "description": "갭 분석은 지식맵(commit basis 금지)에서 파생된 추론이므로 knowledge-map과 동일하게 commit basis를 쓸 수 없다."
    },
    "gapNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "basis", "evidence", "parentRefs", "origin", "locked", "topic", "text", "selfAssessment"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9:_-]+$",
          "description": "이 노드의 고유 ID. L4(plan) 노드가 parentRefs로 이 ID를 인용한다."
        },
        "basis": { "$ref": "#/$defs/basis" },
        "evidence": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidenceCitation" },
          "description": "AC-12: 빈 배열이면 basis는 insufficient여야 한다."
        },
        "parentRefs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "description": "knowledge-map.json nodes[].id 참조 목록. AC-14 계층 ID 참조 무결성 검사 대상. 상위(plan)로의 역참조는 금지."
        },
        "origin": { "type": "string", "enum": ["generated", "user"] },
        "locked": { "type": "boolean" },
        "topic": {
          "type": "string",
          "x-termField": true,
          "minLength": 1,
          "description": "갭이 식별된 지식 주제명(기술 용어·고유명사 — 언어 린트 제외)."
        },
        "text": {
          "type": "string",
          "x-freeText": true,
          "description": "이 갭에 대한 서술(한국어로)."
        },
        "selfAssessment": {
          "type": "string",
          "x-freeText": true,
          "description": "사용자가 입력한 자가진단 원문 요약(한국어로). 퀴즈로 재검증하지 않는다(MVP 범위)."
        }
      },
      "allOf": [
        {
          "if": { "properties": { "evidence": { "maxItems": 0 } } },
          "then": { "properties": { "basis": { "const": "insufficient" } } }
        }
      ]
    }
  }
}
