{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devcareer-prep.local/schemas/plan.schema.json",
  "title": "DevCareer Prep Learning Plan",
  "description": "L4 학습 계획/코딩테스트 문제(plan.json, Phase 3). gap-report.json 노드 ID만 참조한다(단방향 6계층 참조, 역참조 0건). CurriculumDesigner가 생성하며, 문제 산출물의 신뢰 등급은 경력 기술서(career.json)와 명시적으로 분리 표기한다(verificationStatus).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "generatedAt", "sourceRepoHead", "contentHash",
    "coverage", "truncated", "nodes"
  ],
  "properties": {
    "schemaVersion": { "$ref": "#/$defs/schemaVersion" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "sourceRepoHead": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$",
      "description": "생성 시점 대상 레포 HEAD. AC-22 스테일 판정의 정본 값."
    },
    "contentHash": { "type": "string", "minLength": 1 },
    "coverage": { "$ref": "#/$defs/coverage" },
    "truncated": { "$ref": "#/$defs/truncated" },
    "nodes": {
      "type": "array",
      "items": { "$ref": "#/$defs/planNode" }
    }
  },
  "$defs": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "default": "0.1.0"
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["analyzed", "total", "traversed", "period", "exclusions", "samplingMethod"],
      "properties": {
        "analyzed": { "type": "integer", "minimum": 0 },
        "total": { "type": "integer", "minimum": 0 },
        "traversed": { "type": "integer", "minimum": 0 },
        "period": {
          "type": "object",
          "additionalProperties": false,
          "required": ["since", "until"],
          "properties": {
            "since": { "type": ["string", "null"], "format": "date" },
            "until": { "type": ["string", "null"], "format": "date" }
          }
        },
        "exclusions": {
          "type": "object",
          "additionalProperties": false,
          "required": ["bots", "vendoredPaths", "mergeIncluded", "selectedIdentities"],
          "properties": {
            "bots": { "type": "boolean" },
            "vendoredPaths": { "type": "boolean" },
            "mergeIncluded": { "type": "boolean" },
            "selectedIdentities": { "type": "array", "items": { "type": "string", "format": "email" } }
          }
        },
        "samplingMethod": { "type": "string", "x-verbatim": true, "minLength": 1 }
      }
    },
    "truncated": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason", "dropped_commits"],
      "properties": {
        "reason": { "type": "string", "enum": ["none", "budget_commits"] },
        "dropped_commits": { "type": "integer", "minimum": 0 }
      },
      "allOf": [
        { "if": { "properties": { "reason": { "const": "none" } } }, "then": { "properties": { "dropped_commits": { "const": 0 } } } },
        { "if": { "properties": { "reason": { "const": "budget_commits" } } }, "then": { "properties": { "dropped_commits": { "minimum": 1 } } } }
      ]
    },
    "evidenceCitation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ledgerId"],
      "properties": {
        "ledgerId": { "type": "string", "minLength": 1 },
        "path": { "type": "string" }
      }
    },
    "basis": {
      "type": "string",
      "enum": ["inference", "external", "insufficient"],
      "description": "plan 노드도 knowledge-map/gap-report와 동일하게 commit basis를 쓸 수 없다(문제·학습 계획은 git 사실이 아니다)."
    },
    "planNode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "type", "basis", "evidence", "parentRefs", "origin", "locked",
        "title", "text", "verificationStatus"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9:_-]+$",
          "description": "이 노드의 고유 ID. plan은 L4(최상위 P0 범위)이므로 이를 참조하는 상위 계층은 없다(grade/L5는 P2, 범위 밖)."
        },
        "type": {
          "type": "string",
          "enum": ["study-topic", "coding-problem"],
          "description": "학습 주제 항목인지 코딩테스트 문제인지."
        },
        "basis": { "$ref": "#/$defs/basis" },
        "evidence": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidenceCitation" },
          "description": "AC-12: 빈 배열이면 basis는 insufficient여야 한다."
        },
        "parentRefs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "description": "gap-report.json nodes[].id만 참조한다(구현 11단계). 문제→gap ID 역참조는 금지되며 AC-14가 검사한다."
        },
        "origin": { "type": "string", "enum": ["generated", "user"] },
        "locked": { "type": "boolean" },
        "title": {
          "type": "string",
          "x-termField": true,
          "minLength": 1,
          "description": "주제/문제 제목(기술 용어·고유명사 다수 — 언어 린트 제외)."
        },
        "text": {
          "type": "string",
          "x-freeText": true,
          "description": "주제 설명 또는 문제 본문(한국어로)."
        },
        "verificationStatus": {
          "type": "string",
          "enum": ["self-verified", "sourced", "unverified"],
          "description": "이 항목의 신뢰 등급. career.json의 evidence 기반 basis 체계와 명시적으로 분리된 별도 축이다 — self-verified(실행으로 자가 검증됨), sourced(출처 링크 있음), unverified(둘 다 아님, '미검증' 배지로 노출)."
        },
        "solutionCode": {
          "type": "string",
          "x-verbatim": true,
          "description": "type:coding-problem일 때의 정답 코드. 코드 블록이므로 언어 린트 대상에서 제외된다."
        },
        "testCases": {
          "type": "array",
          "items": { "type": "string", "x-verbatim": true },
          "description": "type:coding-problem일 때의 테스트 케이스 목록. 가능하면 실제 실행으로 자가 검증하고 verificationStatus:self-verified로 표시한다."
        },
        "sourceUrl": {
          "type": "string",
          "format": "uri",
          "description": "실행으로 자가 검증할 수 없는 개념 문제/주제의 출처 링크. verificationStatus가 sourced일 때 필수이며, 링크가 없으면 unverified로 남긴다."
        }
      },
      "allOf": [
        {
          "if": { "properties": { "evidence": { "maxItems": 0 } } },
          "then": { "properties": { "basis": { "const": "insufficient" } } }
        },
        {
          "if": { "properties": { "type": { "const": "coding-problem" } } },
          "then": { "required": ["solutionCode", "testCases"] }
        },
        {
          "if": { "properties": { "verificationStatus": { "const": "sourced" } } },
          "then": { "required": ["sourceUrl"] }
        }
      ]
    }
  }
}
