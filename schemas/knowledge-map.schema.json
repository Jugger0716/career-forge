{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devcareer-prep.local/schemas/knowledge-map.schema.json",
  "title": "DevCareer Prep Knowledge Map",
  "description": "L2 지식맵(knowledge-map.json). career.json 노드 ID만 참조한다(단방향 6계층 참조). git에는 '필요한 CS 지식'이라는 사실이 존재하지 않으므로 basis:commit은 이 계층에서 금지된다 — inference(근거 커밋 나열) 또는 external(allow-list URL), 둘 다 아니면 insufficient.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "generatedAt", "sourceRepoHead", "contentHash",
    "coverage", "truncated", "nodes"
  ],
  "properties": {
    "schemaVersion": { "$ref": "#/$defs/schemaVersion" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "sourceRepoHead": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$",
      "description": "생성 시점 대상 레포 HEAD. AC-22 스테일 판정의 정본 값."
    },
    "contentHash": { "type": "string", "minLength": 1 },
    "coverage": { "$ref": "#/$defs/coverage" },
    "truncated": { "$ref": "#/$defs/truncated" },
    "nodes": {
      "type": "array",
      "items": { "$ref": "#/$defs/knowledgeNode" }
    }
  },
  "$defs": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "default": "0.1.0"
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["analyzed", "total", "traversed", "period", "exclusions", "samplingMethod"],
      "properties": {
        "analyzed": { "type": "integer", "minimum": 0 },
        "total": { "type": "integer", "minimum": 0 },
        "traversed": { "type": "integer", "minimum": 0 },
        "period": {
          "type": "object",
          "additionalProperties": false,
          "required": ["since", "until"],
          "properties": {
            "since": { "type": ["string", "null"], "format": "date" },
            "until": { "type": ["string", "null"], "format": "date" }
          }
        },
        "exclusions": {
          "type": "object",
          "additionalProperties": false,
          "required": ["bots", "vendoredPaths", "mergeIncluded", "selectedIdentities"],
          "properties": {
            "bots": { "type": "boolean" },
            "vendoredPaths": { "type": "boolean" },
            "mergeIncluded": { "type": "boolean" },
            "selectedIdentities": { "type": "array", "items": { "type": "string", "format": "email" } }
          }
        },
        "samplingMethod": { "type": "string", "x-verbatim": true, "minLength": 1 }
      }
    },
    "truncated": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason", "dropped_commits"],
      "properties": {
        "reason": { "type": "string", "enum": ["none", "budget_commits"] },
        "dropped_commits": { "type": "integer", "minimum": 0 }
      },
      "allOf": [
        { "if": { "properties": { "reason": { "const": "none" } } }, "then": { "properties": { "dropped_commits": { "const": 0 } } } },
        { "if": { "properties": { "reason": { "const": "budget_commits" } } }, "then": { "properties": { "dropped_commits": { "minimum": 1 } } } }
      ]
    },
    "evidenceCitation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ledgerId"],
      "description": "inference basis의 '근거 커밋 나열'용. evidence.json commits[].id 인용, 해시 직접 사용 금지.",
      "properties": {
        "ledgerId": { "type": "string", "minLength": 1 },
        "path": { "type": "string" }
      }
    },
    "basis": {
      "type": "string",
      "enum": ["inference", "external", "insufficient"],
      "description": "KnowledgeMapper 노드는 commit basis를 쓸 수 없다(git에 존재하지 않는 사실이므로). inference(근거 커밋 나열 필수) 또는 external(references/sources.json allow-list 내 URL 필수), 둘 다 아니면 insufficient."
    },
    "knowledgeNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "basis", "evidence", "parentRefs", "origin", "locked", "topic", "text"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9:_-]+$",
          "description": "이 노드의 고유 ID. L3(갭 리포트) 노드가 parentRefs로 이 ID를 인용한다."
        },
        "basis": { "$ref": "#/$defs/basis" },
        "evidence": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidenceCitation" },
          "description": "basis:inference일 때의 근거 커밋 나열. AC-12: 빈 배열이면 basis는 insufficient여야 한다."
        },
        "parentRefs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "description": "career.json nodes[].id 참조 목록(단방향 6계층 참조 — 하위 ID만 인용, 역참조 금지). AC-14 계층 ID 참조 무결성 검사 대상."
        },
        "origin": { "type": "string", "enum": ["generated", "user"] },
        "locked": { "type": "boolean" },
        "topic": {
          "type": "string",
          "x-termField": true,
          "minLength": 1,
          "description": "CS/기술 지식 주제명(기술 용어·고유명사 — 언어 린트 제외)."
        },
        "text": {
          "type": "string",
          "x-freeText": true,
          "description": "이 지식 항목에 대한 서술(한국어로)."
        },
        "externalUrl": {
          "type": "string",
          "format": "uri",
          "description": "basis:external일 때 필수. references/sources.json allow-list 내 URL이어야 한다(allow-list 대조는 스크립트가 런타임에 검사하며 이 스키마는 형식만 검사한다)."
        }
      },
      "allOf": [
        {
          "if": { "properties": { "evidence": { "maxItems": 0 } } },
          "then": { "properties": { "basis": { "const": "insufficient" } } }
        },
        {
          "if": { "properties": { "basis": { "const": "external" } } },
          "then": { "required": ["externalUrl"] }
        }
      ]
    }
  }
}
