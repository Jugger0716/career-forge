# 기본: 텍스트 파일 자동 감지 + 정규화 (CRLF -> LF on commit, 체크아웃 시 플랫폼 기본값)
* text=auto

# 결정적 스크립트는 플랫폼과 무관하게 항상 LF로 고정한다.
# (PowerShell/Windows 체크아웃에서 CRLF로 바뀌면 `node scripts/*.mjs` 실행 자체는 깨지지 않지만,
#  워킹 트리 CR 가드(Phase 0-C, AC-4)가 오탐하고 diff 노이즈가 발생한다.)
scripts/**/*.mjs text eol=lf
tests/**/*.mjs text eol=lf
fixtures/**/*.mjs text eol=lf

# tests/fixtures-invalid/ 는 검증기가 잡아야 하는 "일부러 깨뜨린" 픽스처를 담는다.
# CR 혼입 negative 케이스가 `* text=auto` 정규화로 CR 바이트를 잃으면
# AC-4의 negative 게이트(워킹 트리 CR 가드)가 영구히 관측 불가능해지므로
# 이 하위 트리는 텍스트 정규화 자체를 끈다.
tests/fixtures-invalid/** -text
